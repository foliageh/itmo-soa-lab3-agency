<?xml version="1.0" encoding="UTF-8" standalone="no"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:sch="http://example.com/agency/schemas" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://example.com/agency/schemas" targetNamespace="http://example.com/agency/schemas">
  <wsdl:types>
    <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://example.com/agency/schemas">

    <xs:element name="find_with_balcony_request">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="cheapest" type="xs:boolean"/>
                <xs:element name="with_balcony" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="find_with_balcony_response">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="flat" type="tns:flat"/>

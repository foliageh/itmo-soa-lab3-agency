    </xs:element>

    <xs:element name="get_most_expensive_request">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id1" type="xs:int"/>
                <xs:element name="id2" type="xs:int"/>
                <xs:element name="id3" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="get_most_expensive_response">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="flat" type="tns:flat"/>
                <xs:element minOccurs="0" name="error" type="tns:error_response"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="flat">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="creation_date" type="xs:string"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="coordinates" type="tns:coordinates"/>
            <xs:element minOccurs="0" name="area" type="xs:int"/>
            <xs:element minOccurs="0" name="number_of_rooms" type="xs:int"/>
